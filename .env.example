# Backend environment. Copy to .env for local use, or set these in the Render
# dashboard. Every variable has a working default, so a checkout runs with no
# .env at all.

# Comma-separated browser origins allowed to call the API.
# Default: http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# DEMO | REAL_LOCAL | REAL_RAW. Default: DEMO.
# The real modes need products under data/raw. If they are missing the service
# stays in DEMO and reports why through /data/status; it never falls back
# silently.
DATA_MODE=DEMO

# Port to bind. Render injects this; locally it defaults to 8000.
PORT=8000

# Local dev server only (backend/app/__main__.py, used by `make dev-backend`).
INDU_HOST=127.0.0.1
INDU_PORT=8000
# Set to 0 to disable the reload watcher.
INDU_RELOAD=1
