# ============================================================================
# INDU backend environment.
#
# Copy to .env for local use (.env is gitignored), or set these in the Render
# dashboard. Every variable here has a working default, so a fresh checkout
# runs with no .env at all - but the defaults are the LOCAL DEMO defaults, not
# the deployment ones. See "Deploying to Render" at the bottom.
# ============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Comma-separated browser origins allowed to call the API.
# Default: http://localhost:5173
#
# Parsed in backend/app/main.py by splitting on "," and stripping whitespace.
# Exact string match, so:
#   - NO trailing slash. "https://x.vercel.app/" never matches, because the
#     browser sends the Origin header without one.
#   - Vercel PREVIEW deployments get their own hostnames
#     (indu-git-branch-user.vercel.app) and are NOT covered by the production
#     origin. Add them explicitly if you need previews to reach the API.
#   - A "*" wildcard is deliberately not used: browsers reject a wildcard
#     combined with allow_credentials=True, so it would not be a working
#     policy for any credentialed request.
#
# Deployed, this should be the Vercel production URL. To keep local dev
# working against a deployed backend, list both:
#   CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# DEMO | REAL_LOCAL | REAL_RAW. Default: DEMO.
#
#   DEMO        Procedural terrain from data/demo. No real imagery. Works
#               anywhere with no extra assets.
#   REAL_LOCAL  The derived sector bundle committed under data/sector/
#               (~24 MB: 0.5 m/px OHRC crop, LRO NAC crop, LOLA DEM, 239
#               craters). This is what the deployment should run. It is the
#               only real mode that works from a plain git clone.
#   REAL_RAW    Reads the 6.2 GB mission archive under data/raw, which is
#               deliberately NOT in the repository. Local use only.
#
# A requested mode whose assets are missing leaves the service in DEMO and
# reports the reason through /data/status - it never fails silently, but it
# also does not error. If the deployed site shows the procedural ramp instead
# of real imagery, check this variable first.
DATA_MODE=DEMO

# Port to bind. Render injects this automatically; locally it defaults to 8000.
PORT=8000

# ---------------------------------------------------------------------------
# Local dev server only (backend/app/__main__.py, used by `make dev-backend`)
# ---------------------------------------------------------------------------

INDU_HOST=127.0.0.1
INDU_PORT=8000
# Set to 0 to disable the reload watcher. The watcher is scoped to backend/
# and src/ on purpose: a bare `uvicorn --reload` watches all 22,271 files in
# the tree, including data/, and wedges the process.
INDU_RELOAD=1

# ---------------------------------------------------------------------------
# Deploying to Render
# ---------------------------------------------------------------------------
#
# render.yaml already sets all of this, but it is ONLY read by the Blueprint
# flow (New > Blueprint). A service created through the manual web-service
# form ignores render.yaml entirely, and every value below must then be
# entered by hand in the dashboard.
#
#   PYTHONPATH=backend:src
#       REQUIRED. The app is imported as `app.main` from backend/ and the
#       science package as `lunar_platform` from src/. The build does not
#       install the project as a package, so without this the service dies at
#       startup with: ModuleNotFoundError: No module named 'app'
#
#   DATA_MODE=REAL_LOCAL
#       Otherwise the deployment serves DEMO and none of the real imagery.
#
#   CORS_ORIGINS=https://your-app.vercel.app
#       The deployed frontend origin. See the notes above.
#
#   PYTHON_VERSION=3.13.7
#       3.13 is NOT optional: numpy 2.5.3, scipy 1.18.1 and rasterio 1.5.1 all
#       declare requires-python >=3.12, so an older interpreter fails at
#       pip install with "No matching distribution found for numpy==2.5.3".
#       The committed .python-version file sets this too, but note that a
#       PYTHON_VERSION environment variable TAKES PRECEDENCE over that file -
#       so a stale value left in the dashboard will override the repo and
#       reintroduce the failure. Prefer deleting the dashboard variable and
#       letting .python-version govern.
#
#   Build command:  pip install -r requirements.txt
#   Start command:  uvicorn app.main:app --host 0.0.0.0 --port $PORT
#   Health check:   /data/status
#
# Free-tier services sleep after ~15 minutes idle, so the first request after
# a nap takes 30-60s. The frontend has no retry, so a cold start currently
# surfaces as "failed to fetch".
#
# ---------------------------------------------------------------------------
# Frontend (Vercel)
# ---------------------------------------------------------------------------
#
# See frontend/.env.example. VITE_API_URL must point at the Render URL, and
# Vite inlines it AT BUILD TIME - changing the variable without redeploying
# has no effect.
