# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.env/
# .python-version is deliberately NOT ignored: Render's native Python
# runtime reads it to pick the interpreter, and the pinned numpy, scipy
# and rasterio require >=3.12. It has to be committed to take effect.

# Packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# =========================
# Environment / secrets
# =========================
.env
.env.*
!.env.example

# =========================
# Node / React / Vite
# =========================
frontend/node_modules/
node_modules/

frontend/dist/
frontend/.vite/
.vite/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# IDE / editors
# =========================
.vscode/
.idea/
*.swp
*.swo
*.swn
*~
.DS_Store

# =========================
# Logs
# =========================
*.log
logs/

# =========================
# Project runtime cache
# =========================
data/cache/
!data/cache/.gitkeep

# =========================
# Generated outputs
# =========================
outputs/
!outputs/.gitkeep

# =========================
# Large raw scientific data
# =========================
# data/raw is immutable external mission data and is never committed.
data/raw/
!data/raw/.gitkeep
!data/raw/README.md

# Derived working products prepared from data/raw
data/working/
!data/working/.gitkeep

# Large imagery must never be committed by accident, wherever it lands.
*.zip
*.IMG
*.img
*.cub
*.jp2
# Deliberately selected small crops stay tracked.
!data/demo/**/*.tif
!data/demo/**/*.png
!tests/fixtures/**

# Note: Global exclusions for *.tif, *.img, *.zip, etc. have been removed.
# Small, deliberately selected crops (e.g., in data/demo/ or data/sector/) may be committed.
# The massive raw products are ignored strictly via the data/raw/ exclusion below.

# =========================
# Local real-sector generated data
# =========================
# Keep sector metadata/manifests tracked,
# but ignore generated/large sector assets.
# The sector bundle IS the deployed payload: a small crop of imagery,
# elevation and craters cut from data/raw by scripts/build_sector_bundle.py.
# It has to be committed, or the container clones without the data it serves.
# These directories are therefore tracked. Git cannot re-include a file whose
# parent directory is excluded, so they cannot be excluded-then-negated.
#
# Keep them small. They are checked into the repository.
data/sector/*/input/
data/sector/*/reference/
data/sector/*/cache/

# Always keep the sector manifest
!data/sector/*/manifest.yaml

# =========================
# Temporary files
# =========================
tmp/
temp/
*.tmp
*.bak
*.backup

# =========================
# OS files
# =========================
Thumbs.db
.DS_Store

# =========================
# Local agent / tooling files
# =========================
.task/
.task.md.local

# A second checkout of this project that lives inside it. It is its own git
# repository, so `git add -A` stages it as a gitlink rather than as files,
# and it also breaks pytest collection with duplicate test basenames.
/INDU/
.vercel
.env*
